# Keys live in environment variables only. Copy to .env and never commit it.

# NEAR Intents 1Click API. Sent as the X-API-Key header. Optional for dry quotes.
ONECLICK_API_KEY=

# Optional overrides for the dry-quote spike. Placeholders are used when empty.
SPIKE_RECIPIENT=
SPIKE_REFUND_TO=

# Seller's Base address, for the paywall spike.
SELLER_ADDRESS=

# Optional. The public endpoint is rate limited.
SOLANA_RPC_URL=

# Payer's Solana key, as a JSON byte array or base58. Real funds: keep it small.
SOLANA_PRIVATE_KEY=

# Optional. The seller's Base RPC. It must keep recent state for balance checks.
BASE_RPC_URL=

# Optional. A wallet holding USDC and SOL to simulate the deposit from, for spike:dryrun.
SIMULATE_FROM=
