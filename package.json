{
  "name": "agentpay",
  "version": "0.0.0",
  "private": true,
  "description": "The checkout layer for agents. Any API charges in the token it wants, and the paying agent uses whatever it holds.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc",
    "spike:quote": "node --network-family-autoselection-attempt-timeout=2000 --env-file-if-exists=.env spikes/dry-quote.ts",
    "spike:paywall": "node --network-family-autoselection-attempt-timeout=2000 --env-file-if-exists=.env spikes/paywall-server.ts",
    "spike:read402": "node --network-family-autoselection-attempt-timeout=2000 --env-file-if-exists=.env spikes/read-402.ts",
    "spike:poll": "node --network-family-autoselection-attempt-timeout=2000 --env-file-if-exists=.env spikes/poll-status.ts",
    "spike:dryrun": "node --network-family-autoselection-attempt-timeout=2000 --env-file-if-exists=.env spikes/dry-run-payment.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.5.0"
  }
}
